@article{liu_general_1991,
	title = {A general correlation for saturated and subcooled flow boiling in tubes and annuli, based on a nucleate pool boiling equation},
	volume = {34},
	issn = {0017-9310},
	url = {https://www.sciencedirect.com/science/article/pii/0017931091902346},
	doi = {10.1016/0017-9310(91)90234-6},
	abstract = {Recent accurate correlations for predicting the heat transfer coefficient in saturated flow boiling all contain an empirical boiling number correction. The original idea behind the boiling number correction was to allow for the enhancement of the forced convective heat transfer mechanisms arising from the generation of vapour in the boundary layer next to the wall. However, the presence of the boiling number term appears to prevent application to subcooled boiling, throwing doubt on the physical basis of the correlation. This paper shows that the convective term in the correlation should have a Prandtl number dependence. In this way an accurate predictive method covering a very wide range of parameters is constructed with an explicit nucleate boiling term and without boiling number dependence.},
	pages = {2759--2766},
	number = {11},
	journaltitle = {International Journal of Heat and Mass Transfer},
	shortjournal = {International Journal of Heat and Mass Transfer},
	author = {Liu, Z. and Winterton, R. H. S.},
	urldate = {2026-11-11},
	date = {1991-11-01}
}


